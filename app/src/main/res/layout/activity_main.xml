<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas" android:id="@+id/screenRoot">
    <include layout="@layout/include_brand_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Muted" android:text="@string/welcome_back" android:id="@+id/greetingText" android:visibility="gone" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Title" android:text="@string/your_next_adventure" android:id="@+id/homeTitle" android:textSize="20sp" android:visibility="gone" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/userIconTop" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_ui_user" android:contentDescription="@string/profile_image" android:background="@drawable/bg_icon" android:clickable="true" android:focusable="true" app:tint="@color/primary" android:padding="10dp" android:visibility="gone" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Button" android:text="@string/all_trips" android:id="@+id/btnAll" android:layout_weight="1" android:gravity="center" android:minHeight="48dp" android:padding="10dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:textColor="@color/tab_text" android:layout_marginEnd="6dp" android:visibility="gone" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Button" android:text="@string/upcoming" android:id="@+id/btnUpcoming" android:layout_weight="1" android:gravity="center" android:minHeight="48dp" android:padding="6dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:textColor="@color/tab_text" android:layout_marginEnd="6dp" android:maxLines="1" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Button" android:text="@string/past" android:id="@+id/btnPast" android:layout_weight="1" android:gravity="center" android:minHeight="48dp" android:padding="6dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:textColor="@color/tab_text" android:layout_marginEnd="6dp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Trip.Input" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="@string/search_trips" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/search_places" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:minHeight="56dp" android:padding="16dp" android:textSize="16sp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:imeOptions="actionSearch" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/searchIcon" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_ui_search" android:padding="12dp" android:background="@drawable/bg_icon" android:clickable="true" android:focusable="true" android:layout_marginStart="8dp" android:contentDescription="@string/search_trips" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="18dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Subtitle" android:text="@string/your_trips" android:id="@+id/tripCountLabel" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCreateTrip" style="@style/Widget.Trip.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/create_trip" app:icon="@drawable/ic_ui_plus" app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tripRecycler" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp" android:clipToPadding="false" />
        <androidx.core.widget.NestedScrollView android:id="@+id/statePanel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp">
                <androidx.appcompat.widget.AppCompatImageView android:id="@+id/stateIcon" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_ui_trips" app:tint="@color/muted" android:importantForAccessibility="no" />
                <Space android:layout_width="1dp" android:layout_height="16dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Subtitle" android:text="@string/no_trips_yet" android:id="@+id/stateMessage" android:gravity="center" />
                <Space android:layout_width="1dp" android:layout_height="16dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRetry" style="@style/Widget.Trip.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <ProgressBar android:id="@+id/loadingIndicator" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone" android:indeterminateTint="@color/primary" />
    </FrameLayout>
    <include layout="@layout/include_bottom_navigation" />
</LinearLayout>
