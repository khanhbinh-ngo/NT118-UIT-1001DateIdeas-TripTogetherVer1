<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="84dp" android:padding="16dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_surface">
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/ivProfile" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_user_placeholder" android:contentDescription="@string/profile_image" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Body" android:id="@+id/tvName" android:maxLines="2" android:ellipsize="end" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Caption" android:id="@+id/tvRole" android:layout_marginTop="4dp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/ivDelete" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_ui_trash" android:padding="12dp" android:background="@drawable/bg_icon" android:contentDescription="@string/delete_friend" android:clickable="true" android:focusable="true" />
</LinearLayout>
