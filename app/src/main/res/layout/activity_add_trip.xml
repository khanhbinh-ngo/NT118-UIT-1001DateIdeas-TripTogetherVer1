<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas" android:id="@+id/screenRoot">
    <include layout="@layout/include_brand_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="24dp">
        <Space android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Title" android:text="@string/create_trip" android:id="@+id/screenTitle" android:layout_weight="1" android:layout_marginStart="14dp" android:textSize="20sp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Subtitle" android:text="@string/trip_information" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Muted" android:text="@string/create_trip_hint" android:layout_marginTop="6dp" />
            <Space android:layout_width="1dp" android:layout_height="20dp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Trip.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/trip_name" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTripName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLines="1" android:imeOptions="actionNext" android:minHeight="56dp" android:padding="16dp" android:textSize="16sp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Trip.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/country_name" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCountry" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLines="1" android:imeOptions="actionNext" android:minHeight="56dp" android:padding="16dp" android:textSize="16sp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Subtitle" android:text="@string/trip_photo" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivTripImage" android:layout_width="match_parent" android:layout_height="180dp" android:scaleType="centerCrop" android:src="@drawable/default_trip_image" android:contentDescription="@string/trip_photo" app:shapeAppearanceOverlay="@style/Shape.Trip.Image" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectImage" style="@style/Widget.Trip.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_image" />
            <Space android:layout_width="1dp" android:layout_height="24dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Subtitle" android:text="@string/travel_dates" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Trip.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/start_date" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStartDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:minHeight="56dp" android:padding="16dp" android:textSize="16sp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:focusable="false" android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Trip.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/end_date" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEndDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:minHeight="56dp" android:padding="16dp" android:textSize="16sp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:focusable="false" android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Subtitle" android:text="@string/travel_together" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Muted" android:text="@string/invite_hint" android:layout_marginTop="6dp" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Trip.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/member_emails" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMembers" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress|textMultiLine" android:gravity="top|start" android:minLines="2" android:maxLines="4" android:imeOptions="actionDone" android:minHeight="56dp" android:padding="16dp" android:textSize="16sp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveTrip" style="@style/Widget.Trip.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/create_trip" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
