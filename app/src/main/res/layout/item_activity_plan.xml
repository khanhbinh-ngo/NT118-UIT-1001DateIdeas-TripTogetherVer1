<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp" android:layout_marginBottom="12dp" android:minHeight="90dp" android:background="@drawable/bg_surface">
    <LinearLayout android:layout_width="68dp" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Button" android:id="@+id/tvTime" android:gravity="center" />
        <Space android:layout_width="1dp" android:layout_height="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Heading" android:id="@+id/tvEmoji" android:gravity="center" />
    </LinearLayout>
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Body" android:id="@+id/tvDescription" android:layout_weight="1" android:layout_marginStart="12dp" />
</LinearLayout>
