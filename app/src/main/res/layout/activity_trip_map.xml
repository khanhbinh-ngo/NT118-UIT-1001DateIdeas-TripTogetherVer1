<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas" android:id="@+id/screenRoot">
    <include layout="@layout/include_brand_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <Space android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Title" android:text="@string/trip_location" android:id="@+id/mapTitle" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.fragment.app.FragmentContainerView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Body" android:text="@string/map_location_unavailable" android:id="@+id/mapStatus" android:layout_gravity="bottom" android:padding="20dp" android:background="@drawable/bg_surface" android:layout_margin="20dp" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
