<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas" android:id="@+id/screenRoot">
    <include layout="@layout/include_brand_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_ui_back" android:padding="12dp" android:background="@drawable/bg_icon" android:contentDescription="@string/back" android:clickable="true" android:focusable="true" android:visibility="gone" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Title" android:text="@string/trip_overview" android:id="@+id/screenTitle" android:layout_weight="1" android:layout_marginStart="14dp" android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivTripImage" android:layout_width="match_parent" android:layout_height="212dp" android:scaleType="centerCrop" android:src="@drawable/default_trip_image" android:contentDescription="@string/trip_photo" app:shapeAppearanceOverlay="@style/Shape.Trip.Image" />
                <androidx.appcompat.widget.AppCompatImageView android:id="@+id/btnFavorite" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_ui_heart" android:padding="12dp" android:background="@drawable/bg_icon" android:contentDescription="@string/favorites" android:clickable="true" android:focusable="true" android:layout_gravity="top|end" android:layout_margin="12dp" />
            </FrameLayout>
            <Space android:layout_width="1dp" android:layout_height="22dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Title" android:id="@+id/tvTheTripName" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Subtitle" android:id="@+id/tvCountry" android:layout_marginTop="6dp" />
            <Space android:layout_width="1dp" android:layout_height="20dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_soft">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Caption" android:text="@string/travel_dates" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Body" android:id="@+id/tvDates" android:layout_marginTop="5dp" />
                <Space android:layout_width="1dp" android:layout_height="14dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/icUsers" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_ui_user" android:padding="12dp" android:background="@drawable/bg_icon" android:contentDescription="@string/travel_together" android:clickable="true" android:focusable="true" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Body" android:id="@+id/tvMembers" android:layout_weight="1" android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Caption" android:text="@string/view_members" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Muted" android:id="@+id/tvDescription" />
            <Space android:layout_width="1dp" android:layout_height="24dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Subtitle" android:text="@string/make_it_yours" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEnterPlan" style="@style/Widget.Trip.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/view_itinerary" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnChat" style="@style/Widget.Trip.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_chat" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDocuments" style="@style/Widget.Trip.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shared_files" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Trip.Button" android:text="@string/view_map" android:id="@+id/mapTab" android:minHeight="56dp" android:gravity="center" android:background="@drawable/bg_peach" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
