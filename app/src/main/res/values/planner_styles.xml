<resources>
    <style name="TextAppearance.Trip.Title" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Trip.Heading" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Trip.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Trip.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Trip.Muted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Trip.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Trip.Button" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Trip.Nav" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/nav_icon</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Trip.Kicker" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Widget.Trip.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/canvas</item>
    </style>
    <style name="Widget.Trip.Button.Secondary" parent="Widget.Trip.Button">
        <item name="backgroundTint">@color/surface_soft</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Widget.Trip.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/field_fill</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="boxStrokeWidth">0dp</item>
    </style>
    <style name="Shape.Trip.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Widget.Trip.Menu" parent="Widget.Material3.Button.TextButton">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">14dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>